# Copy to .env (never committed) and fill in. Used by ./run_local.sh
ANTHROPIC_API_KEY=sk-ant-...
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-letter-gmail-app-password
ALERT_TO=you@gmail.com
RESUME_PATH=~/Downloads/your-resume.pdf
# Credit balance shown at console.anthropic.com when you start tracking; add any later top-up to it (optional)
BUDGET_USD=
# Minimum fit score to email (optional, default 55)
MIN_FIT=
