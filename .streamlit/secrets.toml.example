# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud, paste these into App settings → Secrets instead.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional but strongly recommended for a public URL: visitors must enter this
# password (or bring their own API key) before the app spends your credits.
APP_PASSWORD = "choose-something-long"
