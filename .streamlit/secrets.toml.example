# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud, paste these into App settings → Secrets instead.
# BOTH are required: the app refuses to start without them.

ANTHROPIC_API_KEY = "sk-ant-..."
APP_PASSWORD = "choose-something-long-and-unique"

# Optional: override the model later without a code change (default: claude-haiku-5-5)
# MODEL = "claude-sonnet-5-5"
